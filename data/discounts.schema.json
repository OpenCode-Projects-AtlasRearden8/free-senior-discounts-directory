{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dylanasdale.github.io/schemas/discounts.schema.json",
  "title": "Senior discounts directory data",
  "description": "Schema for the single-file senior discounts directory. Copyright (c) 2026 Asdale Dynamics, LLC.",
  "type": "object",
  "required": ["meta", "categories", "discounts"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "tagline", "lastRechecked", "version"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string", "minLength": 1 },
        "lastRechecked": { "$ref": "#/$defs/isoDate" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "blurb"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "blurb": { "type": "string", "minLength": 1 }
        }
      }
    },
    "discounts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/discount" }
    }
  },
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "discount": {
      "type": "object",
      "required": [
        "id",
        "category",
        "name",
        "stores",
        "ageTrigger",
        "deal",
        "whatToShow",
        "howToAsk",
        "variesByStore",
        "variesNote",
        "recheckDate",
        "enabler"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "category": {
          "type": "string",
          "description": "Must match a category id"
        },
        "name": { "type": "string", "minLength": 1 },
        "stores": { "type": "string", "minLength": 1 },
        "ageTrigger": { "type": "string", "minLength": 1 },
        "minAge": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120,
          "description": "Machine-readable youngest age this offer applies to; omit if there is no age gate. Drives the age filter."
        },
        "deal": { "type": "string", "minLength": 1 },
        "whatToShow": { "type": "string", "minLength": 1 },
        "howToAsk": { "type": "string", "minLength": 1 },
        "variesByStore": { "type": "boolean" },
        "variesNote": { "type": "string", "minLength": 1 },
        "recheckDate": { "$ref": "#/$defs/isoDate" },
        "enabler": {
          "type": "string",
          "minLength": 1,
          "description": "Reminder that asking is allowed and costs nothing"
        }
      }
    }
  }
}
